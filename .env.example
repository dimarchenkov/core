CORE_ENV=local
CORE_DEBUG=true
CORE_LOG_LEVEL=INFO
CORE_API_HOST=0.0.0.0
CORE_API_PORT=8000
CORE_DATABASE_URL=postgresql+psycopg://core:core@postgres:5432/core
CORE_REDIS_URL=redis://redis:6379/0
CORE_JWT_SECRET=replace-with-a-long-random-jwt-secret
# Core automatically bootstraps this file on the shared persistent core_secrets volume.
CORE_MASTER_ENCRYPTION_KEY_FILE=/var/lib/core/secrets/master_encryption_key
# Optional production/external-secret-manager override. It must match an existing key file.
# MASTER_ENCRYPTION_KEY=replace-with-a-fernet-key
# AQSI remains inert until explicitly enabled and given a real secret key.
CORE_AQSI_ENABLED=false
# CORE_AQSI_API_KEY=replace-with-aqsi-api-key
CORE_AQSI_TAX_CODE=6
# TEMPORARY: enables a real deferred-order fiscal experiment. Never enable by default.
CORE_AQSI_SALE_SPIKE_ENABLED=false
# CORE_AQSI_SALE_SPIKE_DEVICE_ID=
# Required only for the direct acquiring + fiscal receipt experiment.
# CORE_AQSI_SALE_SPIKE_TAX_SYSTEM_CODE=
# CORE_AQSI_SALE_SPIKE_OPERATION_TTL_MS=120000
# Set only when the AQSI account has more than one active shop.
# CORE_AQSI_SHOP_ID=replace-with-aqsi-shop-id
CORE_AQSI_DEFAULT_GROUP_ID=core-default-goods
CORE_AQSI_DEFAULT_GROUP_NAME=Товары Core
# Remote CUPS is disabled until every value is configured explicitly.
PRINTING_ENABLED=false
CUPS_SERVER=
CUPS_USER=
CUPS_PRINTER=
CUPS_IPP_VERSION=1.1
POSTGRES_DB=core
POSTGRES_USER=core
POSTGRES_PASSWORD=core
